<?xml version="1.0" encoding="utf-8"?>
<!--
   Reglas de respaldo para Android 12 o superior.
   Los datos del piloto (modo investigador) nunca salen del teléfono por la copia de seguridad
   de Google ni al pasar los datos a otro dispositivo: solo se exportan a mano como CSV.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="research/" />
        <exclude domain="sharedpref" path="research.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="research/" />
        <exclude domain="sharedpref" path="research.xml" />
    </device-transfer>
</data-extraction-rules>
